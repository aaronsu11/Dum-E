# Default profile
DEEPGRAM_API_KEY=<your-api-key>
ANTHROPIC_API_KEY=<your-api-key>
ELEVENLABS_API_KEY=<your-api-key>

# AWS profile
AWS_ACCESS_KEY_ID=<you_access_key_id>
AWS_SECRET_ACCESS_KEY=<your_secret_access_key>
# Nova-2 Sonic (speech-to-speech) is only available in us-east-1 / us-west-2 / ap-northeast-1 (OQ2)
AWS_REGION=us-east-1

# Deepgram speech backend (D-05). "hosted" (default) uses the hosted Deepgram
# STT/TTS; "sagemaker" uses the Deepgram-on-SageMaker services. The SageMaker
# path is WIRED but the endpoint is NOT deployed this milestone -- selecting it
# without the endpoint names below raises a ValueError (no silent fallback).
# DUME_DEEPGRAM_BACKEND=hosted

# Required ONLY when DUME_DEEPGRAM_BACKEND=sagemaker (both must be set). Names of
# the deployed SageMaker inference endpoints for Deepgram STT / TTS. Leave unset
# on the default hosted path.
# SAGEMAKER_STT_ENDPOINT_NAME=<your-deepgram-stt-sagemaker-endpoint>
# SAGEMAKER_TTS_ENDPOINT_NAME=<your-deepgram-tts-sagemaker-endpoint>

# Policy inference backend (BACK-02/03/04). Allowed values: "lerobot" |
# "groot-native". The code-level default when this variable is UNSET is
# "lerobot", which currently RAISES -- the LeRobot policy backend is not wired
# until Phase 6. Use "groot-native" for the Isaac-GR00T native ZMQ server that
# works today. An unknown value raises too (never a silent fallback), and an
# exported value here wins over config.example.yaml's controller.policy_backend.
# DUME_POLICY_BACKEND=groot-native

# Joint-value convention fed to the policy, and used for the controller's own
# hardcoded pose vectors (LR-03). "true" -> MotorNormMode.DEGREES;
# "false" -> MotorNormMode.RANGE_M100_100 (percent of the calibrated range).
# Accepted spellings: true/false, 1/0, yes/no, on/off, t/f, y/n. Anything else
# RAISES rather than being read as truthy -- every non-empty string is truthy in
# Python, so guessing would silently select the degrees convention.
#
# The RECORDED VERDICT for the GR00T-N1.7-3B-SO101 checkpoint is percent mode,
# i.e. false -- see docs/UNITS-VERDICT.md for the evidence and its limits. The
# value shipped in config.example.yaml is nonetheless "true", the CURRENT
# EFFECTIVE setting, because the flip is deferred: the controller's four
# hardcoded pose vectors encode today's convention implicitly and must be
# converted in the same change as the flip. This variable exists so that flip
# needs no code edit. Do not flip it in isolation.
# An exported value here wins over config.example.yaml's controller.use_degrees.
# DUME_USE_DEGREES=true

# Per-step motion clamp, in the same units as the joint values above (SAFE-02).
# Any commanded per-joint delta larger than this is clipped toward the present
# position, and the clamp is re-emitted on Dum-E's own log stream. Must parse as
# a positive float; the code-level default is 160.0, derived from the
# checkpoint's per-timestep relative-action extreme plus a margin (see the
# provenance comment on DEFAULT_MAX_RELATIVE_TARGET in
# embodiment/so_arm10x/controller.py). Set to "none" (or off/disabled/null/false)
# to DISABLE the clamp entirely -- not recommended, and never as a way to silence
# a clamp warning: a firing clamp means the value needs re-deriving, not removing.
# DUME_MAX_RELATIVE_TARGET=160.0

# Optional - for observability
LANGFUSE_SECRET_KEY=<your-api-key>
LANGFUSE_PUBLIC_KEY=<your-api-key>
LANGFUSE_HOST=<your-api-key>
